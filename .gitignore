.coverage

# Virtual Environments
.venv/
venv/
env/
ENV/

# Model Weights & Checkpoints (Prevent large binary commits)
*.pt
*.bin
*.onnx
*.safetensors
*.gguf
models/
checkpoints/

# Obsidian Intermediate Indices & Local Workspace Cache
.obsidian/workspace*
.obsidian/cache/
*.tmp
*.log

# Experiment notes: a live log the autonomous research loop writes to
# constantly (dozens of files per overnight run), not source-controlled
# content - copying/syncing these between machines was already producing
# spurious tracked-file diffs. Kept on disk, no longer in git.
obsidian/Experiments/

# Audio Caches & Recordings
*.wav
*.mp3
*.flac
*.pcm
recordings/

# Environment Variables & Secrets
.env
*.key
*.pem
token.txt

